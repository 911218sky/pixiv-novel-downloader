{
  "name": "pixiv-novel-downloader",
  "version": "1.3.0",
  "description": "CLI tool to download Pixiv novels and series as plain-text files",
  "main": "dist/cli.js",
  "type": "commonjs",
  "scripts": {
    "build": "rm -rf dist && tsc",
    "test": "npm run build && node --test test/*.test.js",
    "prestart": "npm run build",
    "start": "node dist/cli.js",
    "novel": "npm run build && node dist/cli.js novel",
    "series": "npm run build && node dist/cli.js series",
    "prepare": "npm run build"
  },
  "bin": {
    "pixiv-novel-dl": "./dist/cli.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/911218sky/pixiv-novel-downloader.git"
  },
  "homepage": "https://github.com/911218sky/pixiv-novel-downloader#readme",
  "bugs": {
    "url": "https://github.com/911218sky/pixiv-novel-downloader/issues"
  },
  "keywords": [
    "pixiv",
    "novel",
    "downloader",
    "cli",
    "typescript",
    "nodejs"
  ],
  "author": "911218sky",
  "license": "AGPL-3.0-only",
  "engines": {
    "node": ">=18"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "devDependencies": {
    "@types/node": "^26.6.4",
    "typescript": "^7.0.2"
  }
}
